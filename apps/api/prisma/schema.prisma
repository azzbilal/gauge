// Gauge — application database schema (source of truth).
// Nine tables, matching docs/PRD.md. The warehouse (Phase 2) copies from these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpertStatus {
  APPLIED
  SCREENING
  ACCEPTED
  REJECTED
  ACTIVE
}

enum Verdict {
  APPROVE
  REJECT
  NEEDS_REVIEW
}

// What a signed-in user may do (docs/pipeline.md §2.1). ADMIN may do all of it.
enum Role {
  AUTHOR
  REVIEWER
  ADJUDICATOR
  ADMIN
}

enum TaskStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  REJECTED
}

model Expert {
  id        String       @id @default(cuid())
  name      String
  domain    String
  status    ExpertStatus @default(APPLIED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  intakeRuns IntakeRun[]
  tasks      Task[] @relation("TaskAuthor")
  taskReviews TaskReview[] @relation("TaskReviewer")
  events     Event[] @relation("EventActor")
  user       User?
}

// A login. Every user is backed by one Expert row, because tasks, reviews and
// events keep pointing at Expert; the user adds credentials and a role.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AUTHOR)
  expertId     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expert Expert @relation(fields: [expertId], references: [id], onDelete: Restrict)
}

model Posting {
  id          String   @id @default(cuid())
  title       String
  description String?
  rubricId    String
  rubric   Rubric   @relation(fields: [rubricId], references: [id])

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  intakeRuns IntakeRun[]
}

model Rubric {
  id       String @id @default(cuid())
  version  Int    @default(1)
  criteria Json // [{ id, label, description, weight }]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postings  Posting[]
}

model IntakeRun {
  id            String  @id @default(cuid())
  expertId      String
  postingId     String
  scores        Json // [{ criterionId, label, score, evidence, confidence }]
  confidence    Float // overall confidence (0..1)
  promptVersion String
  cost          Float   @default(0)
  latencyMs     Int     @default(0)
  createdAt     DateTime @default(now())

  expert  Expert  @relation(fields: [expertId], references: [id])
  posting Posting @relation(fields: [postingId], references: [id])

  @@index([expertId])
  @@index([postingId])
}

// Polymorphic: subject_id points at an intake run OR a task.
// For tasks this is the adjudication record (docs/pipeline.md §2.1): opened as
// NEEDS_REVIEW when the two peer reviewers split, resolved to APPROVE / REJECT.
model ReviewDecision {
  id          String   @id @default(cuid())
  subjectType String // "intake_run" | "task"
  subjectId   String
  reviewerId  String
  verdict     Verdict
  reason      String?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
}

model Campaign {
  id          String @id @default(cuid())
  name        String
  targetCount Int    @default(0)
  specVersion String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model Task {
  id         String     @id @default(cuid())
  campaignId String
  authorId   String
  prompt     String
  spec       String?
  reference  String?
  status     TaskStatus @default(DRAFT)
  isGold     Boolean    @default(false)
  // Gold tasks only: the known answer (true = a reviewer should accept it,
  // false = deliberately broken). Null on every normal task.
  goldExpectedAccept Boolean?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  author   Expert   @relation("TaskAuthor", fields: [authorId], references: [id])

  taskReviews TaskReview[]

  // Layer 2 verification relations (additive; no columns on Task itself).
  requirements Requirement[]
  rubricItems  RubricItem[]
  lintFindings LintFinding[]
  verifierRuns VerifierRun[]
  probeRuns    ProbeRun[]

  @@index([campaignId])
  @@index([authorId])
}

model TaskReview {
  id         String   @id @default(cuid())
  taskId     String
  // Legacy free-text label. New rows store the reviewer's Expert id here too, so
  // existing readers keep working; identity is enforced by reviewerExpertId.
  reviewerId String
  // The reviewer's identity. Null only on reviews written before the two-reviewer
  // protocol; those rows are ignored by consensus, IAA and calibration.
  reviewerExpertId String?
  scores     Json
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())

  task     Task    @relation(fields: [taskId], references: [id])
  reviewer Expert? @relation("TaskReviewer", fields: [reviewerExpertId], references: [id], onDelete: Restrict)

  // One review per reviewer per task. Postgres treats NULLs as distinct, so
  // legacy rows never collide.
  @@unique([taskId, reviewerExpertId])
  @@index([taskId])
  @@index([reviewerExpertId])
}

// Append-only log of every user and system action.
model Event {
  id        String   @id @default(cuid())
  actorId   String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  actor Expert? @relation("EventActor", fields: [actorId], references: [id])

  @@index([type])
  @@index([createdAt])
}

// ================================================================
// Layer 2: verification (docs/pipeline.md §2 Layer 2).
// Purely additive: five tables keyed by task_id, no Layer 1 changes.
// ================================================================

enum CheckMethod {
  MACHINE
  VISUAL
  MANUAL
}

enum VerifySubjectType {
  REFERENCE_SOLUTION
  EXPERT_SUBMISSION
  MODEL_ROLLOUT
}

enum DifficultyTier {
  T0
  T1
  T2
  BROKEN
}

model Requirement {
  id        String  @id @default(cuid())
  taskId    String
  text      String
  kind      String? // dimension, hole, file, value, …
  value     String?
  tolerance String?
  createdAt DateTime @default(now())

  task        Task         @relation(fields: [taskId], references: [id])
  rubricItems RubricItem[]

  @@index([taskId])
}

model RubricItem {
  id            String      @id @default(cuid())
  taskId        String
  requirementId String?
  text          String
  checkMethod   CheckMethod @default(MANUAL)
  weight        Float       @default(1)
  createdAt     DateTime    @default(now())

  task        Task         @relation(fields: [taskId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])

  @@index([taskId])
  @@index([requirementId])
}

model LintFinding {
  id        String   @id @default(cuid())
  taskId    String
  rule      String
  severity  String // info | warning | critical
  detail    String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model VerifierRun {
  id              String             @id @default(cuid())
  taskId          String
  subjectType     VerifySubjectType
  subjectId       String
  verifierVersion String
  results         Json
  passed          Boolean
  createdAt       DateTime           @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([subjectType, subjectId])
}

model ProbeRun {
  id              String        @id @default(cuid())
  taskId          String
  model           String
  rollouts        Int
  solveRate       Float
  tier            DifficultyTier
  verifierVersion String
  createdAt       DateTime      @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}
