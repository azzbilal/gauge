# Application database — the single source of truth.
DATABASE_URL=postgresql://gauge:gauge@localhost:5432/gauge

# API port.
PORT=3000

# Web app origin (for CORS).
WEB_ORIGIN=http://localhost:5173

# M1 intake agent LLM backend: "ollama" (local, default) or "anthropic".
LLM_PROVIDER=ollama

# Local Ollama model. Uses the native /api/chat endpoint so num_ctx can be set:
# the few-shot prompt is ~4k tokens plus the CV, and Ollama silently truncates past the context.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=300000
# Optional: path to a custom few-shot examples file (defaults to the bundled examples.json).
# INTAKE_EXAMPLES_PATH=

# Anthropic (Claude): optional, used only when LLM_PROVIDER=anthropic.
# Set to your available model id, e.g. claude-sonnet-4-20250514.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Slack incoming webhook for low-confidence intake alerts. Leave empty to log alerts instead.
SLACK_WEBHOOK_URL=

# Auth: signs the session JWTs. Required, at least 32 characters; the API refuses to start
# without it. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime (zeit/ms format, e.g. 12h, 7d).
JWT_EXPIRES_IN=12h
# Passwords for the seeded admin@gauge.local and reviewer@gauge.local (prisma:seed).
# Unset, they default to gauge-admin-dev and gauge-reviewer-dev: local databases only.
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_PASSWORD=
